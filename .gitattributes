# Normaliza fim de linha: LF no repositório, nativo no working copy.
# Sem isto, editar nos dois computadores gera diffs de arquivo inteiro.
* text=auto eol=lf

# Scripts precisam de LF mesmo no Windows (o Git Bash executa o hook).
*.sh text eol=lf
.githooks/* text eol=lf

# Binários — nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
