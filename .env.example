# URL pública da instância Supabase self-hosted (sem barra no final)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.suaclinica.com.br

# Chave anon (JWT público). Respeita RLS — usada no browser e nos Server Components.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role. Ignora RLS. NUNCA expor no browser nem commitar.
# Usada apenas em Route Handlers/webhooks (n8n, agente de IA).
SUPABASE_SERVICE_ROLE_KEY=
